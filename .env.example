# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=            # required for `ebb new` and `ebb study` (free: aistudio.google.com)
GROQ_API_KEY=              # optional: enables the backup model (free: console.groq.com)
# EBB_PRIMARY_MODEL=gemini-2.5-flash
# EBB_FALLBACK_MODEL=llama-3.3-70b-versatile
# DATABASE_URL=postgresql://ebb:ebb@localhost:5432/ebb   # for `uv run ebb` outside Docker
