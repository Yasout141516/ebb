# Copy to .env and fill in. Never commit .env.
# Required for `ebb new` and `ebb study` (free: aistudio.google.com).
GOOGLE_API_KEY=
# Optional: enables the backup model (free: console.groq.com).
GROQ_API_KEY=
# Optional: web questions when Ebb repeats itself (free: app.tavily.com).
TAVILY_API_KEY=
# Model names (change these if a provider retires one):
# EBB_PRIMARY_MODEL=gemini-3.8-flash
# EBB_FALLBACK_MODEL=qwen/qwen3.8-27b
# For `uv run ebb` outside Docker:
# DATABASE_URL=postgresql://ebb:ebb@localhost:5432/ebb
# Host port for the Compose database (default 5432):
# EBB_DB_PORT=5432
# Time zone for dates, as an IANA name. In Docker the default is UTC.
# EBB_TIMEZONE=Asia/Dhaka
