# Copy to .env and fill in. Never commit .env.
# Required for the website and for `ebb new` and `ebb study` (free: console.groq.com).
GROQ_API_KEY=
# Optional: the backup model and the eval writer (free plan: console.mistral.ai).
MISTRAL_API_KEY=
# Optional: web questions when Ebb repeats itself (free: app.tavily.com).
TAVILY_API_KEY=
# Optional: any model on OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Model for each kind of work, as provider:model with provider groq, openrouter or mistral
# (change these if a provider retires one). Teach is lessons; quiz is questions and grading.
# EBB_TEACH_MODEL=groq:openai/gpt-oss-120b
# EBB_QUIZ_MODEL=groq:openai/gpt-oss-120b
# The eval writer must differ from the quiz model, which it is checked against:
# EBB_EVAL_WRITER_MODEL=mistral:mistral-medium-latest
# Backups, tried when the main model fails (default: Mistral when MISTRAL_API_KEY is set):
# EBB_TEACH_BACKUP=mistral:mistral-medium-latest
# EBB_QUIZ_BACKUP=mistral:mistral-medium-latest
# Older names, kept as the defaults above (a bare model name; primary is Groq, fallback Mistral):
# EBB_PRIMARY_MODEL=openai/gpt-oss-120b
# EBB_FALLBACK_MODEL=mistral-medium-latest
# Show what each AI call cost (default true):
# EBB_SHOW_COSTS=true
# For `uv run ebb` outside Docker:
# DATABASE_URL=postgresql://ebb:ebb@localhost:5432/ebb
# Host port for the Compose database (default 5432):
# EBB_DB_PORT=5432
# Time zone for dates, as an IANA name. In Docker the default is UTC.
# EBB_TIMEZONE=Asia/Dhaka
# Most AI calls one user may make per day, in their time zone (default 300):
# EBB_DAILY_AI_CALLS=300
# The web app's address, allowed by the API's CORS; several separated by commas
# (default http://localhost:3000,http://127.0.0.1:3000):
# EBB_WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
