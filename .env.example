# Copy to .env and fill in. Never commit .env.
# Required for `ebb new` and `ebb study` (free: console.groq.com).
GROQ_API_KEY=
# Optional: the backup model and the eval writer (free plan: console.mistral.ai).
MISTRAL_API_KEY=
# Optional: web questions when Ebb repeats itself (free: app.tavily.com).
TAVILY_API_KEY=
# Model names (change these if a provider retires one):
# EBB_PRIMARY_MODEL=openai/gpt-oss-120b
# EBB_FALLBACK_MODEL=mistral-medium-latest
# For `uv run ebb` outside Docker:
# DATABASE_URL=postgresql://ebb:ebb@localhost:5432/ebb
# Host port for the Compose database (default 5432):
# EBB_DB_PORT=5432
# Time zone for dates, as an IANA name. In Docker the default is UTC.
# EBB_TIMEZONE=Asia/Dhaka
# Most AI calls one user may make per day, in their time zone (default 300):
# EBB_DAILY_AI_CALLS=300
# The web app's address, allowed by the API's CORS (default http://localhost:3000):
# EBB_WEB_ORIGIN=http://localhost:3000
